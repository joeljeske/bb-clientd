+					})
+					requestReady = nextRequestReady
+					maximumObserved = max(maximumObserved, size)
+				}
+				r.EXPECT().Read(gomock.Any()).Return(0, io.EOF)
+
+				require.NoError(t, s.HandleConnection(r, w))
